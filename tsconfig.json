{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@web/*": ["./src/*"],
      "@/lib/supabase": ["./src/shims/supabase.ts"],
      "@/lib/posthog": ["./src/shims/posthog.ts"],
      "@/*": ["./shared/*"],
      "react-native": ["./src/shims/react-native.ts"],
      "@react-native-async-storage/async-storage": ["./src/shims/async-storage.ts"],
      "@react-native-community/netinfo": ["./src/shims/netinfo.ts"],
      "*": ["./node_modules/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/env.d.ts", "shared/**/*.ts"]
}
