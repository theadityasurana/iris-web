# Client (build time). The Supabase URL and anon key are in src/shims/supabase.ts.
EXPO_PUBLIC_LOGO_DEV_TOKEN=

# Optional build-time SEO tags. Nothing is added until these are set.
IRIS_GA_ID=
IRIS_GSC_TOKEN=
IRIS_BING_TOKEN=

# Cloudflare Pages Functions secrets (Dodo Payments, website only). Never commit real values.
DODO_ENV=test
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Product IDs (DODO_PRODUCT_<PLAN>_<PERIOD>_<REGION>): see docs/dodo-live-products.env and docs/dodo-test-products.env.
